{
  "name": "team-media-hub-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor native shell (iOS/Android) wrapping the Team Media Hub web app",
  "scripts": {
    "sync": "npm run build:web && npx cap sync",
    "build:web": "cd ../frontend && npm run build",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "android:assembleDebug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.1",
    "capacitor-secure-storage-plugin": "^0.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "typescript": "^5.9.3"
  }
}
